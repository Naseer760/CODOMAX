# ===================================================
# Campus Lost & Found Portal - Environment Configuration
# ===================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Database Connection
# If MongoDB is not running locally on 27017, the server will automatically
# launch an embedded MongoDB Memory Server for seamless development.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found

# JWT Secret Key for Authentication
JWT_SECRET=campus_lost_found_super_secret_jwt_key_2026

# Frontend Client URL (for CORS and direct email links)
CLIENT_URL=http://localhost:5173

# Optional: Initial Bootstrap Administrator Credentials (used by scripts/createAdmin.js)
ADMIN_NAME="Campus Administrator"
ADMIN_EMAIL=admin@campus.edu
ADMIN_STUDENT_ID=ADM-001
ADMIN_PASSWORD=AdminPassword@2026

# Optional: SMTP Email Service Configuration (Optional; logs preview to console if omitted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@campus.edu
# SMTP_PASS=your_app_password
# EMAIL_FROM="Campus Lost & Found" <noreply@campuslostfound.edu>
